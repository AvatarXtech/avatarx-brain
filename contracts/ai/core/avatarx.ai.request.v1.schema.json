{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/ai/core/avatarx.ai.request.v1.schema.json",
  "title": "AvatarX AI Core Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "traceId",
    "correlationId",
    "workflowId",
    "sessionId",
    "tenantId",
    "sourceService",
    "targetService",
    "operation",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actorId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "sourceService": {
      "enum": [
        "avatarx-brain",
        "avatarx-intelligence",
        "avatarx-neuron",
        "avatarx-agents",
        "avatarx-memory",
        "avatarx-knowledge",
        "avatarx-ai-director",
        "avatarx-ai-continuity"
      ]
    },
    "targetService": {
      "enum": [
        "avatarx-brain",
        "avatarx-intelligence",
        "avatarx-neuron",
        "avatarx-agents",
        "avatarx-memory",
        "avatarx-knowledge"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}