{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/brain/finishing/failure-diagnosis.v1.schema.json",
  "title": "AvatarX Finishing Failure Diagnosis V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosisId",
    "artifactId",
    "issues",
    "recommendedAction"
  ],
  "properties": {
    "diagnosisId": { "type": "string" },
    "artifactId": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "recommendedAction": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "RECUT",
        "RECOMPOSITE",
        "RETRACK",
        "REROTO",
        "REKEY",
        "REPAINT",
        "REGRADE",
        "RESTORE",
        "ESCALATE_HUMAN"
      ]
    }
  }
}
