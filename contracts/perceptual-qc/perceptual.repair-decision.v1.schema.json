{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/brain/perceptual-qc/repair-decision.v1.schema.json",
  "title": "AvatarX Perceptual Repair Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "artifactId",
    "defectIds",
    "action",
    "confidence"
  ],
  "properties": {
    "decisionId": {
      "type": "string"
    },
    "artifactId": {
      "type": "string"
    },
    "defectIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "action": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "LOCAL_VISUAL_REPAIR",
        "TEMPORAL_REPAIR",
        "AUDIO_REPAIR",
        "SYNC_REPAIR",
        "SUBTITLE_REPAIR",
        "REGENERATE_RANGE",
        "REGENERATE_SHOT",
        "REMIX",
        "RECOMPOSITE",
        "REGRADE",
        "ESCALATE_HUMAN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoningSummary": {
      "type": ["string", "null"]
    }
  }
}
