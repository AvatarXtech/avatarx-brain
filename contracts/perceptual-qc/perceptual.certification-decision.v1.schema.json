{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/brain/perceptual-qc/certification-decision.v1.schema.json",
  "title": "AvatarX Repair Certification Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "artifactId",
    "revalidationId",
    "action"
  ],
  "properties": {
    "decisionId": {
      "type": "string"
    },
    "artifactId": {
      "type": "string"
    },
    "revalidationId": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "CERTIFY",
        "RETRY_LOCAL",
        "RETRY_TEMPORAL",
        "RETRY_AUDIO",
        "REGENERATE",
        "ESCALATE_HUMAN",
        "REJECT"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "remainingRepairBudget": {
      "type": "integer",
      "minimum": 0
    },
    "reasoningSummary": {
      "type": ["string", "null"]
    }
  }
}
