{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avatarx.ai/movie/avatarx.movie.event.v1.json",
  "title": "AvatarX AI Movie Pipeline Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "tenantId",
    "projectId",
    "traceId",
    "occurredAt",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^movie\\.[a-z0-9]+(?:\\.[a-z0-9]+)+$"
    },
    "source": {
      "type": "string",
      "pattern": "^avatarx-[a-z0-9-]+$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "shotId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
