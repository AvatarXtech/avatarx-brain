{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/brain/mastering/release-decision.v1.schema.json",
  "title": "AvatarX Final Release Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "productionId",
    "masterPackageId",
    "action"
  ],
  "properties": {
    "decisionId": {
      "type": "string"
    },
    "productionId": {
      "type": "string"
    },
    "masterPackageId": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "CERTIFY_RELEASE",
        "REPAIR_PACKAGE",
        "REMASTER",
        "RELOCALIZE",
        "REVALIDATE",
        "ESCALATE_HUMAN",
        "REJECT"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoningSummary": {
      "type": ["string", "null"]
    }
  }
}
