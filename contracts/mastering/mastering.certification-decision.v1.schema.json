{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avatarx.ai/contracts/brain/mastering/certification-decision.v1.schema.json",
  "title": "AvatarX Mastering Certification Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "masterPackageId",
    "validationId",
    "action"
  ],
  "properties": {
    "decisionId": {
      "type": "string"
    },
    "masterPackageId": {
      "type": "string"
    },
    "validationId": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "CERTIFY",
        "REMASTER_PICTURE",
        "REMASTER_AUDIO",
        "REBUILD_SUBTITLES",
        "REBUILD_LOCALIZATION",
        "REPACKAGE",
        "REVALIDATE",
        "ESCALATE_HUMAN",
        "REJECT"
      ]
    },
    "reasoningSummary": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
